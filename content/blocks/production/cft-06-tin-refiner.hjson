type: GenericCrafter

name: "Tin Refiner"
description: "Refines Tin using liquid aluminum to access advanced structures. Requires power."
health: 450
size: 2
hasItems: true
hasLiquids: true
hasPower: true
itemCapacity: 20
liquidCapacity: 60

category: crafting
requirements: [ silicon/30, cmtc-itm-02-ruined-tin/35, cmtc-itm-01-quartz/50, cmtc-itm-06-aluminum/10 ]
buildTime: 150

craftTime: 60

consumes: {
    items: [ cmtc-itm-02-ruined-tin/2 ]
    liquids: [ cmtc-lqd-02-liquid-aluminum/0.2 ]
    power: 1
}

outputItem: cmtc-itm-07-refined-tin/1

updateEffect: steam

craftEffect: {
    type: WaveEffect
    sides: 4
    colorFrom: F4F4F4
    colorTo: F4F4F4
    sizeFrom: 0
    sizeTo: 8
    strokeFrom: 3
    strokeTo: 0
    interp: pow2Out
    lifetime: 30
    rotation: 45
}

drawer: {
    type: DrawMulti

drawers: [
{
    type: DrawDefault
    }
{
    type: DrawLiquidRegion
    drawLiquid: cmtc-lqd-02-liquid-aluminum
    alpha: 1
}
    ]
}

research: {
    parent: cft-11-aluminum-melter
    planet: dkv-candemor
}
researchCostMultiplier: 0.25