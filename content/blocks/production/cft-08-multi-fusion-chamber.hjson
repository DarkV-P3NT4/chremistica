type: GenericCrafter

name: "Multi Fusion Chamber"
description: "Somewhat expensive but produces essence matter from these list of recipes."

health: 1000
size: 4
hasItems: true
hasLiquids: true
itemCapacity: 40
liquidCapacity: 96
squareSprite: false

category: crafting
requirements: [ cmtc-itm-04-iron-ingot/100, cmtc-itm-07-refined-tin/80, titanium/50, cmtc-itm-10-darkite/50, silicon/80, graphite/50 ]
buildTime: 150

craftTime: 180

consumes: {
    power: 4
    liquids: [ slag/0.2, cmtc-gas-01-steam/0.4 ]
    items: [ cmtc-itm-10-darkite/18, cmtc-itm-23-darkite-cluster/9 ]
}

outputItems: [ cmtc-itm-09-obsidian/3, cmtc-itm-11-essence-matter/9 ]

craftEffect: vapor

ambientSound: loopSmelter
ambientSoundVolume: 0.15

