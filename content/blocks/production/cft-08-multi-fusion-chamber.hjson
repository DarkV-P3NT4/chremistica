    {
      type: DrawRegion
      suffix: -bottom
    }
{
    type: DrawLiquidTile
    drawLiquid: slag
    padding: 1.5
}
{
    type: DrawLiquidTile
    drawLiquid: cmtc-gas-01-steam
    padding: 1.5
    alpha: 0.5
}
    { 
      type: DrawRegion
      suffix: -spinner
      x: 7
      rotateSpeed: 8
      spinSprite: true
    }
    { 
      type: DrawRegion
      suffix: -spinner
      y: 7
      rotateSpeed: -8
      spinSprite: true
    }
    { 
      type: DrawRegion
      suffix: -spinner
      x: -7
      rotateSpeed: 8
      spinSprite: true
    }
    { 
      type: DrawRegion
      suffix: -spinner
      y: -7
      rotateSpeed: -8
      spinSprite: true
    }
{
      type: DrawDefault
    }
{
    type: DrawGlowRegion
    suffix: -glow
    color: 9773B3
    alpha: 0.8
    }
  ]
}

