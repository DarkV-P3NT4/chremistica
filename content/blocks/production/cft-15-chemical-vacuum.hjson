type: GenericCrafter

name: "Chemical Vacuum"
description: "Extracts gases from bromium."

health: 800
size: 3
hasItems: true
hasLiquids: true
liquidCapacity: 60
itemCapacity: 15

category: crafting
requirements: [ cmtc-itm-09-obsidian/20, cmtc-itm-04-iron-ingot/55, cmtc-itm-07-refined-tin/60, graphite/90, cmtc-itm-12-bromium/80 ]
buildTime: 80

craftTime: 90

consumes: {
    power: 2
    items: [ cmtc-itm-12-bromium/3 ]
}

outputLiquid: gas-05-bromine-gas/0.4

craftEffect: generatespark

ambientSound: loopExtract
