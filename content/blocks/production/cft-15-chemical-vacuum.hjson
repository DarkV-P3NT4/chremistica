    {
      type: DrawRegion
      suffix: -bottom
    }
    { 
      type: DrawRegion
      suffix: -rotator
      rotateSpeed: -6
      spinSprite: true
    }
{
      type: DrawLiquidTile
      drawLiquid: gas-05-bromine-gas
      padding: 1.5
}
    {
      type: DrawDefault
    }
{
      type: DrawParticles
      color: 7A3E19
}
  ]
}

