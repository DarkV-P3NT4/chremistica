    { type: PartMove, progress: recoil, y: -2, rot: -5 }
]
}
{
    type: RegionPart
    suffix: "-blade"
    mirror: true
    under: true
    moveY: -1.5
    moveX: 0.75
    progress: warmup
    moves: [
    { type: PartMove, progress: recoil, y: -2 }
]
}
]
}

