type: ItemTurret

name: "Conflict"
description: "Fires seared violium shells at enemy targets at far range, Best at single target but worse at groups."

health: 1450
size: 4
maxAmmo: 25
ammoPerShot: 5
reload: 300
squareSprite: false

heatRequirement: 60
maxHeatEfficiency: 1

buildTime: 300
requirements: [ silicon/80, cmtc-itm-07-refined-tin/70, graphite/90, cmtc-itm-11-essence-matter/100, cmtc-itm-14-violium-gem/80 ]
category: turret
outlineColor: 1E0D0D

shootSound: shootSniper
soundPitchMin: 0.8
soundPitchMax: 1
recoil: 2
range: 340
trackingRange: 420
shootEffect: shootBigColor
smokeEffect: [ shootBigSmoke, shootSmokeTitan ]
inaccuracy: 0
shootY: 12
velocityRnd: 0
shake: 5
minWarmup: 0.94
shootWarmupSpeed: 0.06
shootCone: 1

coolantMultiplier: 2

consumes: {
    power: 9
}

coolant: {
    type: ConsumeCoolant
    allowGas: false
    allowLiquid: true
    amount: 0.4
}

