immunities: [ cmtc-sts-02-deprived-i, cmtc-sts-02-deprived-ii, cmtc-sts-02-deprived-iii, cmtc-sts-03-speedy-iii, cmtc-sts-04-sluggish-i, cmtc-sts-04-sluggish-ii, cmtc-sts-04-sluggish-iii, cmtc-sts-06-dilemma-i, cmtc-sts-08-ruined-ii, cmtc-sts-08-ruined-iii, blasted ]

