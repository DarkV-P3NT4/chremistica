type: legs

name: "Stem"
description: "Mines and Assists on repairing structures, equipped with an automatic homing orb."

health: 450
armor: 2
speed: 0.88
hitSize: 7.2
range: 100
maxRange: 100
buildSpeed: 0.5
outlineColor: 2F2724
itemCapacity: 5
commands: [move, enterPayload, repair, mine, rebuild, assist]
knockbackMultiplier: 1.2
mineSpeed: 1
mineItems: [ scrap, cmtc-itm-01-quartz, cmtc-itm-02-ruined-tin ]
mineTier: 1

legCount: 4
legLength: 18
legPairOffset: 0.5
lockLegBase: true
legContinuousMove: true
legExtension: -6
legBaseOffset: -0.5
legMaxLength: 1.1
legMinLength: 0.2
legLengthScl: 1
legForwardScl: 1
legMoveSpace: 1.1
legStraightness: 0.2
baseLegStraightness: 0.1
rippleScale: 0.2
deathExplosionEffect: [ dynamicExplosion,
{
    type: SoundEffect
    minPitch: 0.9
    maxPitch: 1
    sound: deathStem
    effect: none
    }
]
allowLegStep: true
hovering: true
legPhysicsLayer: false

stepShake: 0.1
stepSound: walkerStepTiny
stepSoundVolume: 0.5

shadowElevation: 0.2
groundLayer: 69

parts: [
    {
      type: ShapePart
      y: 0
      radius: 8
      stroke: 1
      layer: 110
      circle: true
      hollow: true
      color: 7BCD83FF
    }
    {
      type: HaloPart
      y: 0
      layer: 110
      color: 7BCD83FF
      shapes: 2
      triLength: 4
      haloRadius: 10
      tri: true
      radius: 4
      haloRotateSpeed: -3.2
    }
]

abilities: [
{
    type: RepairFieldAbility
    reload: 300
    amount: 20
    range: 80
    }
{
    type: MoveEffectAbility
    minVelocity: 0.01
    display: false
    interval: 600
    chance: 0.0001
    effect: {
    type: SoundEffect
    minVolume: 0.2
    maxVolume: 0.8
    sound: chirpStem
    effect: coalSmeltsmoke
    }
  }
]

weapons: [
{
    alwaysShooting: true
 	controllable: false
    useAttackRange: false
 	mirror: false
    x: 0
 	y: 0
	 reload: 240
 	recoil: 0
 	shootSound: shootMissilePlasma
    shootSoundVolume: 0.3
    ejectEffect: none

shoot: {
    type: ShootSpread
    shots: 2
    spread: 180
}

bullet: {
    type: BasicBulletType
    sprite: mine-bullet
    width: 8
    height: 8
    shrinkY: 0
    damage: 8
    speed: 3.2
    lifetime: 240
    circleShooter: true
    circleShooterRadius: 15
    circleShooterRotateSpeed: 0.3
    collidesTeam: true
    healPercent: 10
    keepVelocity: false
    hittable: false
    frontColor: 7BCD83FF
    backColor: 528866FF
    trailColor: 528866FF
    hitColor: 7BCD83FF
    trailLength: 4
    shootEffect: shootHeal
    hitEffect: none
    despawnEffect: none

    fragBullets: 2
    fragVelocityMin: 1
    fragOnHit: false
    fragOnAbsorb: false
    fragOnDespawn: true

fragBullet: {
    type: BasicBulletType
    sprite: mine-bullet
    width: 8
    height: 8
    shrinkY: 0
    damage: 8
    speed: 3.2
    lifetime: 60
    homingPower: 0.2
    homingRange: 120
    homingDelay: 0
    collidesTeam: true
    healPercent: 10
    keepVelocity: false
    hittable: false
    frontColor: 7BCD83FF
    backColor: 528866FF
    trailColor: 528866FF
    hitColor: 7BCD83FF
    trailLength: 4
    hitEffect: none
    despawnEffect: none
    }
}
    }
]