deathShake: 8
rotateSpeed: 3
buildSpeed: 0.3
itemCapacity: 0
tankMoveSound: tankMoveSmall
knockbackMultiplier: 0.5
floorMultiplier: 0.8
commands: [move, enterPayload, rebuild, assist]

immunities: [ cmtc-sts-05-amplified-i, cmtc-sts-05-amplified-ii, cmtc-sts-05-amplified-iii, cmtc-sts-06-dilemma-i, cmtc-sts-06-dilemma-ii, cmtc-sts-06-dilemma-iii, cmtc-sts-14-bromine-burns, cmtc-sts-13-sulfur-coated ]


treadRects: [
  [-24, -48, 19, 16]
  [-45, -22, 21, 32]
  [-42,  29, 31, 16]
]

abilities: [
{
    type: ShieldArcAbility
    radius: 28
