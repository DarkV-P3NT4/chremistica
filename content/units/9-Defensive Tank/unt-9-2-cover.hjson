    max: 150
    chanceDeflect: 1
    reflectTime: 1
    reflectBuildingDamage: 0.5
    missileUnitMultiplier: 0.9
    pushDiffLayer: false
    regen: 1.25
    cooldown: 240
    whenShooting: false
    color: D47BC4
}
]

weapons: [
{
    type: BuildWeapon
    name: "lock-build"
    x: 10.5
    y: -3
    rotateSpeed: 5
    mirror: true
}
{
    type: PointDefenseBulletWeapon
    name: "cover-gun"
    mirror: false
    x: 0
    y: 0
    targetSwitchInterval: 2
    targetInterval: 1
    layerOffset: 0.1
    mirror: false
    reload: 15
    shootSound: shootDuo
    recoil: 0.5
    rotateSpeed: 5
    shootY: 10.5

shoot: {
    type: ShootAlternate
    barrels: 2
    spread: 5
}

bullet: {
    rangeOverride: 148
